<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS equivalent of the .htaccess in this folder.

  It is here because Forpsi (and most Czech/Slovak hosts) sell both a Linux and
  a Windows variant of the same webhosting, and the customer picks one when they
  order. On the Windows/IIS variant .htaccess is not read at all — it is just an
  inert text file — so without this every stored booking under data/ and the
  SMTP password in config.php would be one guessed URL away from the public.

  Whichever platform this lands on, the other file is harmless dead weight.
  Keep both; nobody wants to rediscover this during a host migration.

  form.php and export.php stay reachable on purpose: they are the entry points.
  Everything else in here is either a library, a secret, or somebody's phone
  number.
-->
<configuration>
  <system.webServer>

    <security>
      <requestFiltering>
        <!-- No entry points live in these, so no URL should ever reach them. -->
        <hiddenSegments>
          <add segment="lib" />
          <add segment="data" />
        </hiddenSegments>

        <!-- Schema, logs, stored submissions, editor leftovers. -->
        <fileExtensions>
          <add fileExtension=".json"   allowed="false" />
          <add fileExtension=".jsonl"  allowed="false" />
          <add fileExtension=".log"    allowed="false" />
          <add fileExtension=".md"     allowed="false" />
          <add fileExtension=".ini"    allowed="false" />
          <add fileExtension=".bak"    allowed="false" />
          <add fileExtension=".dist"   allowed="false" />
          <add fileExtension=".htaccess" allowed="false" />
        </fileExtensions>

        <!-- The mailbox password, and the template it was copied from. PHP
             reads both off disk, so blocking them over HTTP costs nothing. -->
        <denyUrlSequences>
          <add sequence="config.php" />
          <add sequence="config.example.php" />
        </denyUrlSequences>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- IIS merges this file into the site-wide web.config one level up,
             and <add> on a name that already exists there is a hard 500 rather
             than a warning. Hence <remove> before every <add>: it is what lets
             these override the looser site-wide values. -->
        <remove name="X-Robots-Tag" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />

        <!-- These endpoints return JSON, CSV or plain text and nothing else,
             so a response from here should not be able to load anything. -->
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; sandbox" />

        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="no-referrer" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
